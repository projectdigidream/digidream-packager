# Where the Tauri RUNNER is built for Linux and Windows (packager/shells/tauri).
#
# Linux: against WebKitGTK 4.1 on Ubuntu 22.04 -- the oldest maintained base, so
# the runner starts on 22.04+, Debian 12+, Fedora 36+ (which also have
# libwebkit2gtk-4.1, the one thing a player must have installed).
# Windows: cross-compiled with cargo-xwin, which fetches Microsoft's CRT and SDK
# libraries on first use (and so accepts their licence) to link for the MSVC
# target Tauri expects; WebView2 comes with Windows 10/11.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl build-essential pkg-config file \
      libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
      clang lld llvm \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustup target add x86_64-pc-windows-msvc \
    && cargo install --locked cargo-xwin
WORKDIR /work
