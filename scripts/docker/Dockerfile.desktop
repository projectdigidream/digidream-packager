# Where a packaged LINUX game is RUN for packager/test/desktop.smoke.mjs: the
# libraries Electron needs on a desktop, and a virtual display (Xvfb). A real
# desktop has all of these; a container has none, which also makes this the
# list a game's "it does not start" report should be checked against.
FROM digidream-kit-test
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb xauth dbus libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libgtk-3-0 libgbm1 libasound2 libxkbcommon0 libxcomposite1 libxdamage1 \
      libxrandr2 libpango-1.0-0 libcairo2 libxshmfence1 x11-apps imagemagick icoutils libwebkit2gtk-4.1-0 \
    && rm -rf /var/lib/apt/lists/*
